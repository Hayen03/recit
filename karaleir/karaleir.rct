{
  version: 2,
  titre: "Le mystère de la jungle de Karalair",
  auteur: "Léo Jetzer",
  synopsis: "\
Avec ta compagne d'aventure et cartographe Émily, explorer la jungle de Karalair et ses environs pour en découvrir les secrets. \n\n\
Créer ton personnage décidez le cours de cette aventure d'exploration et de survie où les dangers peuvent survenir à n'importe quel momment.",
  image: "title",
  depart: "debut",
  attributs: ["force", "agilite", "endurance", "connaissance", "presence", "perception", "chance", "creativite"],
  global: {
    timeoday: '${fn hour ->\
      "late_night" if hour < 4 else \
      "early_morning" if hour < 8 else \
      "morning" if hour < 12 else \
      "afternoon" if hour < 16 else \
      "evening" if hour < 20 else \
      "night"}',
    timoday_table: {
      late_night: "Tard la nuit",
      early_morning: "Tôt le matin",
      morning: "Matin",
      afternoon: "Après-midi",
      evening: "Soirée",
      night: "Nuit",
    },
    fmttimeoday: '${fn timeofday -> let name = recit.timoday_table.tryget(timeofday) for name if name != null else error("Time of day not recognized: " + timeofday)}',
    prof_bonus_table: {
      untrained: 0,
      trained: 2,
      expert: 4,
      master: 6,
      legend: 8,
    },
    profbonus: '${fn prof -> let bonus = recit.prof_bonus_table.tryget(prof) for bonus if bonus != null else error("Proficiency level not recognized: " + prof)}',
    fmttime: '${fn hour, minute -> str(hour).zfill(2) + ":" + str(minute).zfill(2)}',
    advrank: '${fn rank -> "trained" if rank == "untrained" else\
      "expert" if rank == "trained" else\
      "master" if rank == "expert" else\
      "legend" if rank == "master" else\
      rank}',
    prof_name_table: {
      untrained: "Non formé",
      trained: "Formé",
      expert: "Expert",
      master: "Maître",
      legend: "Légendaire",
    },
    fmtrank: '${fn prof -> let name = recit.prof_name_table.tryget(prof) for name if name != null else error("Proficiency level not recognized: " + prof)}',
    ajouter_recette: '${fn recettes -> let current_recipes = personnage.tags.fiche.recipes for\
      (current_recipes + recettes).unique()}',
    ajouter_connaissance: '${fn connaissances -> let current_knowledge = personnage.tags.fiche.knowledge for\
      (current_knowledge + connaissances).unique()}',
    skill_name_table: {
      athletics: "Athlétisme",
      acrobatics: "Acrobatie",
      thievery: "Escamotage",
      diplomacy: "Diplomatie",
      intimidation: "Intimidation",
      deception: "Tromperie",
      insight: "Perspicacité",
      investigation: "Investigation",
      medicine: "Médecine",
      nature: "Nature",
      occultism: "Occultisme",
      performance: "Performance",
      religion: "Religion",
      society: "Société",
      stealth: "Discrétion",
      survival: "Survie",
      arcana: "Arcanes",
      crafting: "Artisanat",
      dodge: "Esquive",
      block: "Blocage",
      parry: "Parade",
      fortitude: "Robustesse",
      reflex: "Réflexes",
      will: "Volonté",
      armors: "Armures",
      weapons: "Armes"
    },
    fmtskill: '${fn skill -> let name = recit.skill_name_table.tryget(skill) for name if name != null else error("Skill not recognized: " + skill)}',
    fmtknowledge: '${fn knowledge -> let source = recit.knowledges.tryget(knowledge) for source.label if exists(source) else knowledge}',
    fmtrecipe: '${fn recipe -> let source = recit.recipes.tryget(recipe) for source.label.fmt() + "[" + source.ingredients.map(\
      fn ingr -> (fmtingrtrait(ingr.id.slice(1, ingr.len())) if ingr.id.startswith("#") else let ingr_data = recit.items.tryget(ingr.id) for ingr_data.label if exists(ingr_data) else ingr.id) + \
        ("" if ingr.qt == 1 else " x" + str(ingr.qt))\
      ).join(", ") + "]" if exists(source) else recipe}',
    fmtingrtrait: '${fn trait -> let label = recit.ingrtraits.tryget(trait) for "#" + (label if exists(label) else trait)}',
    get_weapon_of_type: '${fn typ -> [weapon for weapon in personnage.objets if "weapon" in weapon.traits and typ == weapon.id].tryget(0)}',
    current_region: '${fn -> let nav = personnage.tags.navigation.tryget("stack") for nav[-1] if exists(nav) else null}',
    has_item: '${fn item_id -> [item for item in personnage.objets if item.id == item_id and (args.len() == 1 or item.quantite >= args[1])].len() > 0}',
    open_hours: '${fn shop -> let hour = personnage.tags.horloge.heures for hour >= shop.hours.open and hour < shop.hours.close}',
    mk_subs_connections: '${fn -> let \
      region_id = recit.current_region(), \
      region = recit.world.regions.tryget(region_id) if exists(region_id) else null for [\
        {\
          "destination": sub_id + "_hub",\
          "texte": sub_conn.texte.fmt(),\
          "conditions": {\
            "type": "formule",\
            "formule": let req = sub_conn.tryget("required") for fn -> req() if exists(req) else true,\
          },\
          "cellules": [\
            {\
              "effets": [\
                {\
                  "type": "incrementer_tag",\
                  "filtre": "navigation.stack",\
                  "valeur": [sub_id],\
                }\
              ],\
            },\
            {\
              "effets": [\
                {\
                  "type": "definir_tag",\
                  "filtre": "navigation.connection_duration",\
                  "valeur": sub_conn.duration if exists(sub_conn.duration) else 0,\
                }\
              ],\
            },\
          ]\
        } for sub_id, sub_conn in (region.tryget("subs") or [])\
      ] if exists(region) else []}',
    mk_return_connection: '${fn ->\
      let curr_region_id = recit.current_region(), \
      curr_region = recit.world.regions.tryget(curr_region_id) if exists(curr_region_id) else null, \
      region_id = personnage.tags.navigation.stack.tryget(-2), \
      region = recit.world.regions.tryget(region_id) if exists(region_id) else null for\
      [{\
        "destination": region_id + "_hub",\
        "texte": "Retourner à " + region.nom if exists(region.nom) else "Retourner",\
        "conditions": [{"type": "formule", "formule": let req = region.tryget("required") for fn -> req() if exists(req) else true}],\
        "cellules": [\
          {\
            "effets": [\
              {\
                "type": "definir_tag",\
                "filtre": "navigation.stack",\
                "valeur": personnage.tags.navigation.stack.slice(0, -1),\
              },\
              {\
                "type": "definir_tag",\
                "filtre": "navigation.connection_duration",\
                "valeur": let dur = region.subs.tryget(curr_region_id) for dur if exists(dur) else 0,\
              },\
            ],\
          }\
        ],\
      }] if exists(curr_region) and exists(region) else []\
    }',
    mk_conns_connections: '${fn -> let \
      region_id = recit.current_region(), \
      region = recit.world.regions.tryget(region_id) if exists(region_id) else null for \
      [\
        {\
          "destination": sub_id + "_hub",\
          "texte": sub_conn.texte.fmt(),\
          "conditions": {\
            "type": "formule",\
            "formule": let req = sub_conn.tryget("required") for fn -> req() if exists(req) else true,\
          },\
          "cellules": [\
            {\
              "effets": [\
                {\
                  "type": "definir_tag",\
                  "filtre": "navigation.stack",\
                  "valeur": personnage.tags.navigation.stack.slice(0, -(let depth = sub_conn.tryget("depth") for depth if exists(depth) else 1)),\
                }\
              ],\
            },\
            {\
              "effets": [\
                {\
                  "type": "definir_tag",\
                  "filtre": "navigation.connection_duration",\
                  "valeur": sub_conn.duration if exists(sub_conn.duration) else 0,\
                }\
              ],\
            },\
          ]\
        } for sub_id, sub_conn in (region.tryget("conns") or []) if sub_id != personnage.tags.navigation.stack.tryget(-2)\
      ] if exists(region) else []}',
    mk_shops_connections: '${fn -> \
      let region_id = recit.current_region(), \
      region = recit.world.regions.tryget(region_id) if exists(region_id) else null for [\
        {\
          "destination": "shop",\
          "texte": shop_conn.texte.fmt(),\
          "cellules": [\
            {\
              "effets": [\
                {\
                  "type": "definir_tag",\
                  "filtre": "navigation.shopping.shop",\
                  "valeur": shop_id,\
                }\
              ],\
            },\
            {\
              "effets": [\
                {\
                  "type": "definir_tag",\
                  "filtre": "navigation.connection_duration",\
                  "valeur": shop_conn.tryget("duration") or 0,\
                }\
              ],\
            },\
          ],\
        } if (let req = shop_conn.tryget("required") for req() if exists(req) else true) else null\
        for shop_id, shop_conn in (region.tryget("shops") or [])].filter(fn shop -> exists(shop)) \
      if exists(region) else []\
    }',
    mk_hub_connections: '${fn -> recit.mk_shops_connections() + recit.mk_subs_connections() + recit.mk_conns_connections() + recit.mk_return_connection()}',
    incrtrust: '${fn curr, incr -> (curr + incr).clamp(-recit.constants.max_trust, recit.constants.max_trust)}',
    getnpc: '${fn source -> let id = source() if type(source) == "func" else source, npc = recit.world.npcs.tryget(id) if exists(id) and (type(id) == "str") else null for [id, npc] if exists(npc) else null}',
    geteffectiveprice: '${fn price, haggle, npc -> let \
      npc = recit.getnpc(npc),\
      npc_data = personnage.tags.npcs.tryget(npc[0]) if exists(npc[0]) else null,\
      trust = npc_data.tryget("trust") or 0.0 if exists(npc_data) else 0.0\
      for (price * (1.0 - 0.1*(haggle or 0)).max(0.0) * (1.0 - 0.01*trust).max(0.0)).ceil() \
    }',
    getmerchantquote: '${fn shop_id, quote_id, default -> let \
      shop = recit.world.shops.tryget(shop_id) if exists(shop_id) else null,\
      npc_couple = recit.getnpc(shop.tryget("npc")) if exists(shop) else null,\
      npc_id = npc_couple[0] if exists(npc_couple) else null,\
      npc = npc_couple[1] if exists(npc_id) else null,\
      npc_name = npc.tryget("nom") if exists(npc) else null,\
      npc_phrase = shop.tryget(quote_id) if exists(npc) else null\
      for recit.fmttxt(npc_name or "Marchand") + ": " + recit.fmttxt(npc_phrase or default)\
    }',
    gethaggleduration: '${fn shop_id -> let \
      shop = recit.world.shops.tryget(shop_id) if exists(shop_id) else null,\
      duration = shop.tryget("haggle_duration") if exists(shop) else null\
      for duration if duration != null else recit.constants.default_haggle_duration\
    }',
    gettransactionduration: '${fn shop_id -> let \
      shop = recit.world.shops.tryget(shop_id) if exists(shop_id) else null,\
      duration = shop.tryget("transaction_duration") if exists(shop) else null\
      for duration if duration != null else recit.constants.default_transaction_duration\
    }',
    gethaggledc: '${fn shop_id -> let \
      shop = recit.world.shops.tryget(shop_id) if exists(shop_id) else null,\
      base_dc = shop.tryget("haggle_base_dc") if exists(shop) else null,\
      dc = base_dc if base_dc != null else recit.constants.default_haggle_base_dc,\
      npc_couple = recit.getnpc(shop.tryget("npc")) if exists(shop) else null,\
      npc_id = npc_couple[0] if exists(npc_couple) else null,\
      npc_data = personnage.tags.npcs.tryget(npc_id) if exists(npc_id) else null,\
      npc_trust = npc_data.tryget("trust") if exists(npc_data) else null\
      for let modifier = -(npc_trust or 0)*0.01 for dc + int(modifier) if type(modifier) in ["int", "float"] else error("Invalid modifier type (got " + str(modifier) + ")")\
    }',
    getmoney: '${fn -> let coins = personnage.objets.find(fn item -> item.id == "silver_coin") for coins.quantite if exists(coins) else 0}',
    fmttxt: '${fn txt -> let txt = fmttxt(txt()) if type(txt) == "func" else fmttxt(txt.choice()) if type(txt) == "list" else txt for txt.fmt() if exists(txt) else str(txt)}',
    addtobag: '${fn bag, item -> [item] if bag != null and bag.len() == 0 else null if bag == null else let \
      bf = bag[0], \
      it = bf + {"qt": item.qt + bf.qt, "total": item.total + bf.total} if bf.id == item.id and bf.data == item.data else null,\
      rest = bag.slice(1, bag.len())\
      for [it] + rest if exists(it) else [bf] + recit.addtobag(rest, item)}',
    /// Cooking stuff
    prepingredients: '${fn -> [\
      {"id": ingr.id, "qt": ingr.quantite}\
      for ingr in personnage.objets\
      if "ingredient" in ingr.traits\
    ]}',
    matchingredient: '${fn ingr, target -> \
      target.id.slice(1, target.id.len()) in recit.items[ingr.id].traits\
      if target.id.startswith("#")\
      else ingr.id == target.id\
    }',
    takeingredient: '${fn allocation, ingr -> \
      let disponible = allocation.restants.tryget(ingr.id, 0),\
          pris = min(disponible, allocation.manquant)\
      for allocation + {\
        "manquant": allocation.manquant - pris,\
        "restants": allocation.restants + {\
          ingr.id: disponible - pris\
        },\
        "retraits": allocation.retraits + {\
          ingr.id: allocation.retraits.tryget(ingr.id, 0) + pris\
        }\
      }\
    }',
    allocateingredient: '${fn plan, target, inventory -> \
      plan if not plan.possible else (\
        let allocation = inventory\
          .filter(fn ingr -> recit.matchingredient(ingr, target))\
          .reduce(\
            recit.takeingredient,\
            {\
              "manquant": target.qt,\
              "restants": plan.restants,\
              "retraits": plan.retraits\
            }\
          )\
        for {\
          "possible": allocation.manquant == 0,\
          "restants": allocation.restants,\
          "retraits": allocation.retraits\
        }\
      )\
    }',
    planingredients: '${fn inventory, ingredients -> \
      let exacts = ingredients.filter(fn target -> not target.id.startswith("#")),\
          traits = ingredients.filter(fn target -> target.id.startswith("#")),\
          ordered = exacts + traits,\
          initial = {\
            "possible": true,\
            "restants": inventory.reduce(\
              fn restants, ingr -> restants + {\
                ingr.id: restants.tryget(ingr.id, 0) + ingr.qt\
              },\
              {}\
            ),\
            "retraits": {}\
          }\
      for ordered.reduce(\
        fn plan, target -> recit.allocateingredient(plan, target, inventory),\
        initial\
      )\
    }',
    hasingredients: '${fn inventory, ingredients -> \
      recit.planingredients(inventory, ingredients).possible\
    }',
    /// Data
    world: {
      regions: {
        bellevue: {
          nom: "Bellevue",
          subs: {
            bellevue_ingredient_market: {
              texte: "Visiter le marché d'ingrédients de Bellevue.",
              duration: 5
            },
            bellevue_blacksmith: {
              texte: "Se rendre à la forge.",
              duration: 10
            },
          },
          shops: {},
          conns: {},
        },
        bellevue_ingredient_market: {
          nom: "Marché d'ingrédients de Bellevue",
          subs: {},
          shops: {
            bellevue_veggie_shop: {
              texte: "Acheter des légumes chez Lulu.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_veggie_shop)}',
            },
            bellevue_meat_shop: {
              texte: "Acheter de la viande chez Philippe.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_meat_shop)}',
            },
            bellevue_fruit_shop: {
              texte: "Visiter l'étal de Marie la fruitière.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_fruit_shop)}',
            },
            bellevue_fish_shop: {
              texte: "Magasiner du poisson chez Jacques le poissonier.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_fish_shop)}',
            },
            bellevue_bakery: {
              texte: "Aller chez le boulanger.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_bakery)}',
            },
            bellevue_spice_shop: {
              texte: "Acheter des épices, des herbes et du sel chez Benoît.",
              duration: 2,
              required: '${fn -> open_hours(recit.world.shops.bellevue_spice_shop)}',
            },
          },
          conns: {},
        },
        bellevue_blacksmith: {
          nom: "Forge de Bellevue",
          subs: {},
          shops: {
            bellevue_blacksmith_shop: {
              texte: "Magasiner des armes.",
              duration: 5,
            },
            bellevue_blacksmith_armory: {
              texte: "Magasiner des armures.",
              duration: 5,
            },
          },
          conns: {},
        },
      },
      npcs: {
        lulu: {
          nom: "Lulu",
        },
        philippe: {
          nom: "Philippe",
        },
        marie: {
          nom: "Marie",
        },
        jacques: {
          nom: "Jacques",
        },
        benoit: {
          nom: "Benoît",
        },
        mercedes: {
          nom: "Mercedes",
        },
        thomas: {
          nom: "Thomas",
        },
      },
      shops: {
        bellevue_veggie_shop: {
          nom: "Les légumes de Lulu",
          texte: "Bienvenue au marché d'ingrédients de Bellevue.",
          texte_qt: "Et combien je t'en sert?",
          texte_refus: "Hahahaha. C'est bien beau l'enthousiasme, mais je ne crois pas que tu as les moyens pour ça.",
          texte_qtneg: "Hahahaha. Tu crois que je vais te vendre ça pour moins que rien? Tu rêves.",
          texte_no_transaction: "Pffff. Tu me fais perdre mon temps.",
          texte_accept: "Ravis de faire affaire avec toi.",
          texte_haggle_success: "Pfff. d'accord, d'accord. Je te fais un prix spécial.",
          texte_haggle_fail: "Hahahaha. Tu crois que je vais te faire un prix spécial? Tu rêves. C'est ma dernière offre.",
          npc: "lulu",
          transaction_duration: 5,
          haggle_duration: 5,
          haggle_base_dc: 10,
          items: [
            {id: "carrot", prix: 1},
