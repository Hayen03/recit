            else prof for skill, prof in skills}}',
        },
        {
          type: "incrementer_tag",
          filtre: "fiche.xp",
          valeur: "${[recit.constants.skill_upgrade_xp if count >= recit.constants.skill_upgrade_threshold else 0 for skill, count in personnage.tags.fiche.skill_uses].sum()}",
        },
        {
          type: "definir_tag",
          filtre: "fiche.skill_uses",
          valeur: '${let skill_uses = personnage.tags.fiche.skill_uses for \
