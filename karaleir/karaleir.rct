    {
      id: "level_up",
      libelle: "Mettre à jour le niveau",
      effets: [
        {
          type: "definir_tag",
          filtre: "calc.old_level",
          valeur: "${personnage.tags.fiche.level}",
        },
        {
          type: "incrementer_tag",
          filtre: "fiche.level",
          valeur: "${personnage.tags.fiche.xp // recit.constants.levelup_xp_threshold}",
          notification: '${"Tu te sens plus puissant!" if (valeur-ancienne) == 1 else "Tu te sens beaucoup plus puissant!"}',
        },
        {
          type: "definir_tag",
          filtre: "fiche.xp",
          valeur: "${personnage.tags.fiche.xp % recit.constants.levelup_xp_threshold}",
        },
        { // health increase (max health is done automatically by the level effect)
          type: "modifier_pv",
          valeur: "${(recit.constants.increase_hp + personnage.attributs.endurance) * (personnage.tags.fiche.level - personnage.tags.calc.old_level)}",
          notification: "",
        },
        // mettre à jour les stats d'Émily si le niveau du personnage a augmenté
        {
          type: "definir_tag",
          filtre: "emily.hp_max",
          valeur: "${valeur + (personnage.tags.fiche.level - personnage.tags.calc.old_level) * 10}",
        },
        {
          type: "definir_tag",
          filtre: "emily.moral_max",
          valeur: "${valeur + (personnage.tags.fiche.level - personnage.tags.calc.old_level) * 12}",
        },
        {
          type: "definir_tag",
          filtre: "emily.hp",
          valeur: "${valeur + (personnage.tags.fiche.level - personnage.tags.calc.old_level) * 10}",
        },
        {
          type: "definir_tag",
          filtre: "emily.moral",
          valeur: "${valeur + (personnage.tags.fiche.level - personnage.tags.calc.old_level) * 12}",
        }
      ],
      conditions: {
        type: "tag_requis",
        filtre: [
          "fiche.xp",
          {type: "superieure", chemin: "xp", valeur: '${recit.constants.levelup_xp_threshold - 1}'},
        ],
      },
