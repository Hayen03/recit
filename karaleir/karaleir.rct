    // autres
  },
  etats: {
    fatigue: {
      nom: '${"Reposé" if etat.donnees.severity == 0 else "Fatigué" if etat.donnees.severity == 1 else "Épuisé"}',
      description: '${"Tu es completement reposé" if etat.donnees.severity == 0 else "Tu es fatigué, tu devrais te reposer. Les actions demandant de la concentration seront plus difficiles." if etat.donnees.severity == 1 else "Tu es épuisé, tu devrais te reposer. Les actions demandant de la concentration seront très difficiles."}',
      traits: ["needs"],
      effets: [
        {
          type: "modificateur_test",
          valeur: "${-etat.donnees.severity}",
          categorie: "needs",
          filtre: {
            type: "un_des_traits",
            traits: ["concentrate"],
          },
        },
      ],
      donnees: {
        severity: 0,
      },
    },
    hunger: {
      nom: '${"Rassasié" if etat.donnees.severity == 0 else "Affamé" if etat.donnees.severity == 1 else "Gravement Affamé"}',
      description: '${"Tu es rassasié" if etat.donnees.severity == 0 else "Tu as faim, tu devrais manger. Les actions physiques seront plus difficiles." if etat.donnees.severity == 1 else "Tu es gravement affamé, tu devrais manger. Les actions physiques seront très difficiles."}',
      traits: ["needs"],
      effets: [
        {
          type: "modificateur_test",
          valeur: "${-etat.donnees.severity}",
          categorie: "status",
          filtre: {
            type: "un_des_traits",
            traits: ["physical"],
          },
        },
      ],
      donnees: {
        severity: 0,
      },
    },
    thirst: {
      nom: '${"Hydraté" if etat.donnees.severity == 0 else "Assoiffé" if etat.donnees.severity == 1 else "Gravement Assoiffé"}',
      description: '${"Tu es bien hydraté" if etat.donnees.severity == 0 else "Tu as soif, tu devrais boire. Il sera plus difficile de te défendre." if etat.donnees.severity == 1 else "Tu es gravement assoiffé, tu devrais boire. Il sera très difficile de te défendre."}',
      traits: ["needs"],
      effets: [
        {
          type: "modificateur_test",
          valeur: "${-etat.donnees.severity}",
          categorie: "status",
          filtre: {
            type: "un_des_traits",
            traits: ["defense"],
          },
        },
      ],
      donnees: {
        severity: 0,
      },
    },
    puissance: {
      nom: "Puissance ${personnage.tags.fiche.level}",
      description: "Tu es de niveau ${personnage.tags.fiche.level}, ce qui te permet de mieux réussir dans les actions pour lesquelles tu es compétent.",
      effets: [
        {
          type: "modificateur_test",
          valeur: '${personnage.tags.fiche.level if [prof != "untrained" and "skill_"+skill in test.traits for skill, prof in personnage.tags.fiche.skills if prof != "untrained"].any() else 0}',
          categorie: "level",
        },
        {
          type: "modificateur_pv_max",
          valeur: "${(recit.constants.increase_hp + personnage.attributs.endurance) * personnage.tags.fiche.level}",
          categorie: "level",
        },
        {
          type: "modificateur_moral_max",
          valeur: "${(recit.constants.increase_moral + personnage.attributs.endurance) * personnage.tags.fiche.level}",
          categorie: "level",
        },
      ],
    },
    skilled: {
      nom: "Compétent",
      description: "Tu es formé et compétent dans certaines choses, ce qui te permet de mieux réussir certaines actions.",
      effets: [
        {
          type: "modificateur_test",
          valeur: '${([recit.profbonus(prof) for skill, prof in personnage.tags.fiche.skills if "skill_"+skill in test.traits] + [0]).max()}',
          categorie: "proficiency",
        },
      ],
    },
    armor: {
      nom: "${let armor = personnage.tags.fiche.armor for \"Sans Armure\" if armor == null else armor.nom}",
      description: "${let armor = personnage.tags.fiche.armor for \"Tu n'as pas d'armure\" if armor == null else armor.description}",
      effets: [
        {
