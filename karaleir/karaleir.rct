    character_creation_08: {
      titre: "Sauvé par la cloche",
      tags: {
        duration: 0,
        show_clock: false,
        show_status: false,
        do_needs: false,
      },
      cellules: [
        {
          id: "hurler",
          libelle: "En cas de hurlement",
          texte: "Les brigands te regardent te lever en riant. Le plus proche te donne un violent coup de pied dans le ventre qui te plie en deux et te renvoie au sol.",
          conditions: {
            type: "formule",
            formule: '${personnage.tags.fiche.background.tryget("dying") == "hurler"}',
          },
        },
        {
          id: "trick",
          libelle: "En cas de tour",
          texte: "Le brigand hurle de douleur et s'éloigne. Les autres arrête de rire et l'un d'eux vient t'écraser la tête dans la terre.",
          conditions: {
            type: "formule",
            formule: '${personnage.tags.fiche.background.tryget("dying") == "trick"}',
          },
        },
        {
          id: "abandonner",
          libelle: "En cas d'abandon",
          texte: "Te voyant, les brigands éclatent de rire encore plus fort.",
