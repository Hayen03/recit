      effets: [
        {
          type: "incrementer_tag",
          filtre: "fiche.needs.water",
          valeur: '${-page.duration * recit.constants.thirst_multiplier * (page.thirst_multiplier if "thirst_multiplier" in page else 1.0)}',
        },
        {
          type: "incrementer_tag",
          filtre: "fiche.needs.food",
          valeur: '${-page.duration * recit.constants.hunger_multiplier * (page.hunger_multiplier if "hunger_multiplier" in page else 1.0)}',
        },
        {
          type: "incrementer_tag",
          filtre: "fiche.needs.sleep",
          valeur: '${-page.duration * recit.constants.fatigue_multiplier * (page.fatigue_multiplier if "fatigue_multiplier" in page else 1.0)}',
        },
        {
          type: "modifier_etat",
          filtre: "thirst",
          selection: "premier",
          donnees: {
            severity: "${let water = personnage.tags.fiche.needs.water for 0 if water > 50.0 else 1 if water > 30.0 else 2 if water > 10.0 else 3}"
          },
          notification: '${let severity = etat.donnees.severity for ("Tu es assoiffé, tu devrais boire." if severity == 1 else "Tu es déshydraté, tu devrais boire.") if severity != ancienne.severity and severity > 0 else ""}',
        },
        {
          type: "modifier_etat",
          filtre: "hunger",
          selection: "premier",
          donnees: {
            severity: "${let food = personnage.tags.fiche.needs.food for 0 if food > 50.0 else 1 if food > 30.0 else 2 if food > 10.0 else 3}"
          },
          notification: '${let severity = etat.donnees.severity for ("Tu as faim, tu devrais manger." if severity == 1 else "Tu es affamé, tu devrais manger.") if severity != ancienne.severity and severity > 0 else ""}',
        },
        {
          type: "modifier_etat",
          filtre: "fatigue",
          selection: "premier",
          donnees: {
            severity: "${let sleep = personnage.tags.fiche.needs.sleep for 0 if sleep > 50.0 else 1 if sleep > 30.0 else 2 if sleep > 10.0 else 3}"
          },
          notification: '${let severity = etat.donnees.severity for ("Tu es fatigué, tu devrais te reposer." if severity == 1 else "Tu es épuisé, tu devrais te reposer.") if severity != ancienne.severity and severity > 0 else ""}',
        },
